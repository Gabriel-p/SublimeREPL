[
    {
        "id": "tools",
        "children": [
            {
                "caption": "SublimeREPL-py",
                "mnemonic": "R",
                "id": "SublimeREPL-py",
                "children": [
                    {
                        "caption": "Run Current File",
                        "command": "project_venv_repl",
                        "args": {
                            "name": "python"
                        }
                    },
                    {
                        "caption": "Interactive",
                        "command": "project_venv_repl",
                        "args": {
                            "interactive": true,
                            "name": "python"
                        }
                    },
                    {
                        "caption": "-"
                    }
                ]
            }
        ]
    },
    {
        "caption": "Preferences",
        "mnemonic": "n",
        "id": "preferences",
        "children": [
            {
                "caption": "Package Settings",
                "mnemonic": "P",
                "id": "package-settings",
                "children": [
                    {
                        "caption": "SublimeREPL-py",
                        "children": [
                            {
                                "caption": "Settings",
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/sublimeREPL-py/SublimeREPL-py.sublime-settings"
                                }
                            },
                        ],
                        "id": "sublimereplpy"
                    }
                ]
            }
        ]
    }
]